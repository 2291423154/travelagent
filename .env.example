# TravelAgent 环境变量配置
# 复制此文件为 .env 并填入你的 API Key

# LLM 配置（OpenAI 兼容 API）
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=deepseek-v4-flash
OPENAI_EMBEDDING_MODEL=text-embedding-v1

# 数据库
DB_URI=postgresql://agent:agent123@localhost:5432/postgres?sslmode=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# 高德地图 MCP（用于 POI 搜索、路线规划、天气等）
AMAP_MAPS_API_KEY=your_amap_key_here

# Amadeus 酒店 API（可选——不配也能用，Agent 会用 RAG + 高德替代）
# https://developers.amadeus.com 免费注册，无需企业认证
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# 飞书 Bot（可选）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Langfuse 可观测性（可选）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# CI/CD 自动评估（可选——不配 Secrets 则 CI 自动跳过）
# 在 GitHub Settings → Secrets → Actions 中添加：
#   OPENAI_API_KEY, OPENAI_BASE_URL, AMAP_MAPS_API_KEY
